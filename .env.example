# 복사해서 .env 로 저장하고 값을 채워라. (.env 는 git 에 올라가지 않는다)

# ElevenLabs — 더빙·효과음(·배경음악). https://elevenlabs.io → 프로필 → API Keys
# 무료 플랜도 API 키가 나온다(월 10,000 크레딧 ≈ 90초 나레이션 6~10편). 단 무료 플랜은 비상업용이고,
# 배경음악 생성(music 명령)은 유료 플랜 전용이다 — 무료면 bgm.mp3 를 직접 넣어라.
ELEVENLABS_API_KEY=

# 목소리 ID. 비우면 기본 제공 목소리를 쓴다. 바꾸려면 ElevenLabs 보이스 라이브러리에서 ID 복사
ELEVENLABS_VOICE_ID=

# 모델. eleven_v3 (기본) 또는 eleven_multilingual_v2
TTS_MODEL=eleven_v3

# 자막 폰트를 바꾸려면 절대경로 (기본: Pretendard-Black, doctor 가 내려받는다)
# SUBTITLE_FONT=

# 로그인 프로필·폰트가 저장되는 폴더 (기본 ~/.flowmaker)
# FLOWMAKER_HOME=
